<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SPEC (Source of Truth):
        - Module: com.festivaltap:persistence (version 1.0.0, jar), implementing swappable JDK and AWS DynamoDB persistence adapters for festival-tap.
        - Runtime/Java target: Requires Java 24 or higher and compiles with Java 24 release target.
        - What is downloaded (inbound):
          * From https://maven.pkg.github.com/sugarcoat-labs: com.sugarcoatlabs:persistence-engines-core (1.0.0) and com.sugarcoatlabs:persistence-engines-dynamodb (1.0.0).
          * From https://maven.pkg.github.com/festival-tap: com.festivaltap:core-ports (1.0.0, the outbound ports contract).
          * From Maven Central (test scope only): org.junit.jupiter:junit-jupiter for adapter tests.
        - Boundary rule: This module may depend on com.festivaltap:core-ports, and must never depend on com.festivaltap:core-domain.
        - What is distributed (outbound): Publishes com.festivaltap:persistence (1.0.0 jar and pom) to https://maven.pkg.github.com/festival-tap/persistence.
        -->

    <groupId>com.festivaltap</groupId>
    <artifactId>persistence</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Festival Tap - Persistence</name>
    <description>Swappable JDK and AWS DynamoDB persistence adapters implementing outbound repository and event store ports for festival-tap.</description>
    <url>https://github.com/festival-tap/persistence</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/festival-tap/persistence.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/festival-tap/persistence.git</developerConnection>
        <url>https://github.com/festival-tap/persistence</url>
    </scm>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <core.version>1.0.0</core.version>
        <sugarcoat.version>1.0.0</sugarcoat.version>
        <junit.version>5.11.4</junit.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.sugarcoatlabs</groupId>
            <artifactId>persistence-engines-core</artifactId>
            <version>${sugarcoat.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sugarcoatlabs</groupId>
            <artifactId>persistence-engines-dynamodb</artifactId>
            <version>${sugarcoat.version}</version>
        </dependency>
        <!-- Core ports contract -->
        <dependency>
            <groupId>com.festivaltap</groupId>
            <artifactId>core-ports</artifactId>
            <version>${core.version}</version>
        </dependency>

        <!-- JUnit 5 for adapter tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github-sugarcoat-labs</id>
            <name>GitHub Packages - sugarcoat-labs</name>
            <url>https://maven.pkg.github.com/sugarcoat-labs</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap</name>
            <url>https://maven.pkg.github.com/festival-tap</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-spec</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[24,)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.festivaltap:core-domain</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap/persistence</name>
            <url>https://maven.pkg.github.com/festival-tap/persistence</url>
        </repository>
        <snapshotRepository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap/persistence</name>
            <url>https://maven.pkg.github.com/festival-tap/persistence</url>
        </snapshotRepository>
    </distributionManagement>
</project>